{% for logfile in system_text_logs %}
{{ logfile }}
{% endfor %}
{
    daily
    dateext
    dateformat {{ logrotate_dateformat }}
    dateyesterday
    rotate {{ retention_days }}
    maxage {{ retention_days }}
    missingok
    ifempty
    compress
    delaycompress
    sharedscripts
    postrotate
        /usr/bin/systemctl kill --kill-who=main --signal=HUP {{ rsyslog_service_name }} >/dev/null 2>&1 || true
    endscript
}
